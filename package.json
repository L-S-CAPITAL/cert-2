{
  "name": "electrotech-terminal",
  "version": "1.0.0",
  "description": "Bloomberg-style learning terminal for Certificate II in Electrotechnology (UEE22020)",
  "author": {
    "name": "ElectroTech Terminal",
    "email": "maintainer@electrotech.local"
  },
  "homepage": "https://tafeqld.edu.au/course/17/17886/certificate-ii-in-electrotechnology-career-start",
  "main": "electron-main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "tsc --noEmit && vite build",
    "build:electron": "electron-builder",
    "preview": "vite preview",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.electrotech.terminal",
    "productName": "ElectroTech Terminal",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "electron-preload.js",
      "icon.png",
      "!**/node_modules/**"
    ],
    "asar": true,
    "afterPack": "./scripts/afterPack.js",
    "mac": {
      "category": "public.app-category.education"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "category": "Education",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {},
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@electron/fuses": "^2.1.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.1.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0"
  }
}
