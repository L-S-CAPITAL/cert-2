{
  "name": "electrotech-terminal",
  "version": "1.0.0",
  "description": "Bloomberg-style learning terminal for Certificate II in Electrotechnology (UEE22020)",
  "author": {
    "name": "ElectroTech Terminal",
    "email": "maintainer@electrotech.local"
  },
  "homepage": "https://github.com/L-S-CAPITAL/cert-2",
  "main": "electron-main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "tsc --noEmit && vite build",
    "build:electron": "electron-builder",
    "preview": "vite preview",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.electrotech.terminal",
    "productName": "ElectroTech Terminal",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "electron-navigation.js",
      "electron-window-state.js",
      "electron-preload.js",
      "icon.png",
      "!**/node_modules/**"
    ],
    "asar": true,
    "afterPack": "./scripts/afterPack.js",
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "category": "Education",
      "icon": "build/icons",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {},
  "devDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@electron/fuses": "^2.1.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wait-on": "^9.1.0"
  }
}
